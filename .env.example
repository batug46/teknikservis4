# ========================================
# DATABASE
# ========================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Examples:
# - Local: postgresql://postgres:password@localhost:5432/teknikservis
# - Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname
# - Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/teknikservis"

# ========================================
# NEXTAUTH.JS AUTHENTICATION
# ========================================
# Your site URL (change for production)
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
# IMPORTANT: Change this in production!
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# ========================================
# EMAIL SERVICE (RESEND)
# ========================================
# Get API key from: https://resend.com/api-keys
# Used for: Email verification, password reset, notifications
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ========================================
# ADMIN SETUP
# ========================================
# Secret for creating first admin account
# Visit /create-admin and use this secret
# After creating admin, you can remove this
ADMIN_CREATE_SECRET="change-this-secret-key"

# ========================================
# SITE CONFIGURATION
# ========================================
# Public site URL (used in emails, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Node environment
NODE_ENV="development"

# Enable debug logs (optional)
# DEBUG="true"

# ========================================
# OPTIONAL: FUTURE FEATURES
# ========================================
# Uncomment when you implement these features

# Stripe (Payment processing)
# STRIPE_PUBLIC_KEY="pk_test_xxxx"
# STRIPE_SECRET_KEY="sk_test_xxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxx"

# Twilio (SMS notifications)
# TWILIO_ACCOUNT_SID="ACxxxx"
# TWILIO_AUTH_TOKEN="xxxx"
# TWILIO_PHONE_NUMBER="+1234567890"

# AWS S3 (Image uploads)
# AWS_S3_BUCKET="your-bucket"
# AWS_ACCESS_KEY_ID="xxxx"
# AWS_SECRET_ACCESS_KEY="xxxx"
# AWS_REGION="us-east-1"

# Google Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ========================================
# NOTES
# ========================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in all required values
# 3. Never commit .env to version control
# 4. Keep your secrets safe!
# 5. Use different values for development/production
